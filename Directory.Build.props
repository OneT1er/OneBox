<Project>
  <PropertyGroup>
    <!-- The legacy WPF surface still uses nullable-disabled APIs; keep this
         explicit until that surface is migrated without changing runtime
         behavior. New contracts/helpers should remain null-safe by design. -->
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <DebugType>portable</DebugType>
    <Deterministic>true</Deterministic>
    <!-- Single application version source used by every executable and scripts/package.ps1. -->
    <Version>1.7.2</Version>
  </PropertyGroup>
</Project>
