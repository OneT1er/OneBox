<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <RootNamespace>PowerAudioManager</RootNamespace>
    <AssemblyName>OneBox</AssemblyName>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>app.ico</ApplicationIcon>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
    <SatelliteResourceLanguages>en;zh-Hans</SatelliteResourceLanguages>
  </PropertyGroup>

  <!-- Framework-dependent single-file publish: one OneBox.exe, requires the
       .NET 8 Desktop Runtime on the user's machine. Build with:
         dotnet publish -c Release -r win-x64 -p:SelfContained=false -->
  <PropertyGroup>
    <PublishSingleFile>true</PublishSingleFile>
    <SelfContained>false</SelfContained>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <!-- 必须为 true：把 native 依赖（ML.NET 的 FastTreeNative/LdaNative、Vortice、LibreHardwareMonitorLib 等）
         打包进单文件 exe，启动时解压到 %TEMP%\.net\OneBox\<hash>\。否则只发 OneBox.exe 的自动更新
         会让 FastTree 找不到 FastTreeNative.dll -> 训练 0x8007007E 失败（自学习"立即训练"无效）。 -->
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <IncludeAllContentForSelfExtract>false</IncludeAllContentForSelfExtract>
    <!-- ReadyToRun precompiles IL to native, cutting cold-start JIT.
         Only costs ~3 MB on a 37 MB exe, worth keeping. -->
    <PublishReadyToRun>true</PublishReadyToRun>
  </PropertyGroup>

  <ItemGroup>
    <EmbeddedResource Include="app.ico" />
    <EmbeddedResource Include="app.png" />
    <EmbeddedResource Include="icon-power.png" />
    <EmbeddedResource Include="icon-audio.png" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="LibreHardwareMonitorLib" Version="0.9.6" />
    <PackageReference Include="System.Text.Encoding.CodePages" Version="10.0.9" />
    <PackageReference Include="Vortice.DXGI" Version="3.8.3" />
    <PackageReference Include="MaterialDesignThemes" Version="5.1.0" />
    <PackageReference Include="System.ServiceProcess.ServiceController" Version="8.0.0" />
    <!-- 自学习决策树：ML.NET FastTree 多分类（电源计划/音频设备预测） -->
    <PackageReference Include="Microsoft.ML" Version="3.0.1" />
    <PackageReference Include="Microsoft.ML.FastTree" Version="3.0.1" />
  </ItemGroup>

</Project>
