<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>$(OneBoxWindowsTargetFramework)</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <RootNamespace>PowerAudioManager</RootNamespace>
    <AssemblyName>OneBox</AssemblyName>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>app.ico</ApplicationIcon>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
    <SatelliteResourceLanguages>en;zh-Hans</SatelliteResourceLanguages>
  </PropertyGroup>

  <!-- Framework-dependent folder publish. The output intentionally contains
       the application executable, managed dependencies and resources as a
       complete multi-process directory. -->
  <PropertyGroup>
    <SelfContained>false</SelfContained>
  </PropertyGroup>

  <ItemGroup>
    <EmbeddedResource Include="app.ico" />
    <EmbeddedResource Include="app.png" />
    <!-- H.NotifyIcon.Wpf reopens BitmapImage.UriSource at runtime. Keep the
         authored icon beside every framework-dependent executable, while the
         same file remains the ApplicationIcon and embedded fallback. -->
    <None Update="app.ico" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="Always" />
  </ItemGroup>

  <!-- SDK default globs must not compile sources or generated obj files that
       belong to the sibling executable/class-library projects under src. -->
  <ItemGroup>
    <Compile Remove="OneBox.Contracts\**\*;OneBox.Service\**\*;OneBox.Hardware\**\*;Shared\**\*" />
    <EmbeddedResource Remove="OneBox.Contracts\**\*;OneBox.Service\**\*;OneBox.Hardware\**\*;Shared\**\*" />
    <None Remove="OneBox.Contracts\**\*;OneBox.Service\**\*;OneBox.Hardware\**\*;Shared\**\*" />
    <Content Remove="OneBox.Contracts\**\*;OneBox.Service\**\*;OneBox.Hardware\**\*;Shared\**\*" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="OneBox.Contracts\OneBox.Contracts.csproj" />
    <!-- Build the two companion processes before the GUI. Their assemblies
         are intentionally not compile-time references; the target below
         composes their runnable artifacts beside OneBox.exe. -->
    <ProjectReference Include="OneBox.Service\OneBox.Service.csproj" ReferenceOutputAssembly="false" />
    <ProjectReference Include="OneBox.Hardware\OneBox.Hardware.csproj" ReferenceOutputAssembly="false" />
    <PackageReference Include="CommunityToolkit.Mvvm" />
    <PackageReference Include="NAudio" />
    <PackageReference Include="Vortice.DXGI" />
    <PackageReference Include="H.NotifyIcon.Wpf" />
    <PackageReference Include="System.ServiceProcess.ServiceController" />
    <PackageReference Include="Velopack" />
  </ItemGroup>

  <!-- A normal solution build must be runnable from the GUI output directory,
       just like the folder-publish output used by Velopack. Build-order-only
       project references ensure these directories exist before this target. -->
  <Target Name="CopyOneBoxCompanionBuildOutputs" AfterTargets="Build"
          Condition="'$(DesignTimeBuild)' != 'true' and '$(IsCrossTargetingBuild)' != 'true'">
    <PropertyGroup>
      <_OneBoxServiceOutputDir>$(MSBuildProjectDirectory)\OneBox.Service\bin\$(Configuration)\$(OneBoxWindowsTargetFramework)\</_OneBoxServiceOutputDir>
      <_OneBoxHardwareOutputDir>$(MSBuildProjectDirectory)\OneBox.Hardware\bin\$(Configuration)\$(OneBoxWindowsTargetFramework)\$(OneBoxCompanionRuntimeIdentifier)\</_OneBoxHardwareOutputDir>
      <_OneBoxServiceOutputDir Condition="'$(RuntimeIdentifier)' != ''">$(MSBuildProjectDirectory)\OneBox.Service\bin\$(Configuration)\$(OneBoxWindowsTargetFramework)\$(RuntimeIdentifier)\</_OneBoxServiceOutputDir>
      <_OneBoxHardwareOutputDir Condition="'$(RuntimeIdentifier)' != ''">$(MSBuildProjectDirectory)\OneBox.Hardware\bin\$(Configuration)\$(OneBoxWindowsTargetFramework)\$(RuntimeIdentifier)\</_OneBoxHardwareOutputDir>
    </PropertyGroup>
    <ItemGroup>
      <_OneBoxCompanionArtifacts Include="$(_OneBoxServiceOutputDir)*.exe;$(_OneBoxServiceOutputDir)*.dll;$(_OneBoxServiceOutputDir)*.json;$(_OneBoxServiceOutputDir)*.pdb" />
      <_OneBoxCompanionArtifacts Include="$(_OneBoxHardwareOutputDir)*.exe;$(_OneBoxHardwareOutputDir)*.dll;$(_OneBoxHardwareOutputDir)*.json;$(_OneBoxHardwareOutputDir)*.pdb" />
    </ItemGroup>
    <Copy SourceFiles="@(_OneBoxCompanionArtifacts)"
          DestinationFiles="@(_OneBoxCompanionArtifacts->'$(TargetDir)%(Filename)%(Extension)')"
          SkipUnchangedFiles="true" />
    <Message Importance="Low" Text="Composed OneBox companion outputs into $(TargetDir)" />
  </Target>

</Project>
