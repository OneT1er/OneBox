<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <RootNamespace>PowerAudioManager</RootNamespace>
    <AssemblyName>OneBox</AssemblyName>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>app.ico</ApplicationIcon>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
    <SatelliteResourceLanguages>en;zh-Hans</SatelliteResourceLanguages>
  </PropertyGroup>

  <!-- Framework-dependent folder publish. The output intentionally contains
       the application executable, managed dependencies and resources as a
       complete multi-process directory. -->
  <PropertyGroup>
    <SelfContained>false</SelfContained>
  </PropertyGroup>

  <ItemGroup>
    <EmbeddedResource Include="app.ico" />
    <EmbeddedResource Include="app.png" />
    <!-- H.NotifyIcon.Wpf reopens BitmapImage.UriSource at runtime. Keep the
         authored icon beside every framework-dependent executable, while the
         same file remains the ApplicationIcon and embedded fallback. -->
    <None Update="app.ico" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="Always" />
  </ItemGroup>

  <!-- SDK default globs must not compile sources or generated obj files that
       belong to the sibling executable/class-library projects under src. -->
  <ItemGroup>
    <Compile Remove="OneBox.Contracts\**\*;OneBox.Service\**\*;OneBox.Hardware\**\*;Shared\**\*" />
    <EmbeddedResource Remove="OneBox.Contracts\**\*;OneBox.Service\**\*;OneBox.Hardware\**\*;Shared\**\*" />
    <None Remove="OneBox.Contracts\**\*;OneBox.Service\**\*;OneBox.Hardware\**\*;Shared\**\*" />
    <Content Remove="OneBox.Contracts\**\*;OneBox.Service\**\*;OneBox.Hardware\**\*;Shared\**\*" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="OneBox.Contracts\OneBox.Contracts.csproj" />
    <PackageReference Include="CommunityToolkit.Mvvm" />
    <PackageReference Include="NAudio" />
    <PackageReference Include="Vortice.DXGI" />
    <PackageReference Include="H.NotifyIcon.Wpf" />
    <PackageReference Include="System.ServiceProcess.ServiceController" />
    <PackageReference Include="Velopack" />
  </ItemGroup>

</Project>
