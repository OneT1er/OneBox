<Project Sdk="Microsoft.NET.Sdk.Worker">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>$(OneBoxWindowsTargetFramework)</TargetFramework>
    <AssemblyName>OneBox.Service</AssemblyName>
    <RootNamespace>OneBox.Service</RootNamespace>
    <ImplicitUsings>enable</ImplicitUsings>
    <SelfContained>false</SelfContained>
    <RuntimeIdentifier>$(OneBoxCompanionRuntimeIdentifier)</RuntimeIdentifier>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\OneBox.Contracts\OneBox.Contracts.csproj" />
    <PackageReference Include="Microsoft.Extensions.Hosting.WindowsServices" />
    <!-- Host.CreateApplicationBuilder enables the Windows EventLog provider
         through AddWindowsService. Keep its runtime assembly explicit so a
         directory build cannot rely on a late/transitive copy. -->
    <PackageReference Include="System.Diagnostics.EventLog" />
  </ItemGroup>
  <ItemGroup>
    <Compile Include="..\Shared\SecurePipe.cs" Link="Infrastructure\SecurePipe.cs" />
  </ItemGroup>
  <ItemGroup>
    <!-- Do not publish local verification output exposed through the
         workspace's src/OneBox.Service/artifacts reparse point. -->
    <Compile Remove="artifacts\**" />
    <EmbeddedResource Remove="artifacts\**" />
    <None Remove="artifacts\**" />
    <Content Remove="artifacts\**" />
  </ItemGroup>
</Project>
