<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>$(OneBoxWindowsTargetFramework)</TargetFramework>
    <AssemblyName>OneBox.Hardware</AssemblyName>
    <RootNamespace>OneBox.Hardware</RootNamespace>
    <SelfContained>false</SelfContained>
    <RuntimeIdentifier>$(OneBoxCompanionRuntimeIdentifier)</RuntimeIdentifier>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\OneBox.Contracts\OneBox.Contracts.csproj" />
    <PackageReference Include="LibreHardwareMonitorLib" />
  </ItemGroup>
  <ItemGroup>
    <Compile Include="..\Shared\SecurePipe.cs" Link="Infrastructure\SecurePipe.cs" />
  </ItemGroup>
  <ItemGroup>
    <!-- Do not publish local verification output exposed through the
         workspace's src/OneBox.Hardware/artifacts reparse point. -->
    <Compile Remove="artifacts\**" />
    <EmbeddedResource Remove="artifacts\**" />
    <None Remove="artifacts\**" />
    <Content Remove="artifacts\**" />
  </ItemGroup>
</Project>
